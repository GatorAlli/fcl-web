{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-brand/types/**/*.ts",
    ".next-brand/dev/types/**/*.ts",
    ".next-delivery/types/**/*.ts",
    ".next-delivery/dev/types/**/*.ts",
    ".next-release/types/**/*.ts",
    ".next-release/dev/types/**/*.ts",
    ".next-studio/types/**/*.ts",
    ".next-studio/dev/types/**/*.ts",
    ".next-studio-light/types/**/*.ts",
    ".next-studio-light/dev/types/**/*.ts",
    ".next-restored/types/**/*.ts",
    ".next-restored/dev/types/**/*.ts",
    ".next-validation/types/**/*.ts",
    ".next-validation/dev/types/**/*.ts",
    ".next-final-release/types/**/*.ts",
    ".next-final-release/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
