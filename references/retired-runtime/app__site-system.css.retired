/* The established variables in globals.css remain the canonical brand tokens. */
:root {
  --fcl-gutter: clamp(20px, 4.45vw, 72px);
  --fcl-section: clamp(60px, 7.3vw, 112px);
  --fcl-ease: cubic-bezier(0.22, 1, 0.36, 1);
  --scroll-thumb: #a7b3a9;
  --scroll-track: #f6f7f4;
  --scroll-hover: #626a63;
  --scroll-active: #186636;
}
html {
  scrollbar-gutter: stable;
  scrollbar-width: auto;
  scrollbar-color: var(--scroll-thumb) var(--scroll-track);
  scroll-padding-top: 110px;
}
* {
  scrollbar-color: var(--scroll-thumb) var(--scroll-track);
}
::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}
::-webkit-scrollbar-track {
  background: var(--scroll-track);
}
::-webkit-scrollbar-thumb {
  background: var(--scroll-thumb);
  border: 2px solid var(--scroll-track);
  border-radius: 6px;
}
::-webkit-scrollbar-thumb:hover {
  background: var(--scroll-hover);
}
::-webkit-scrollbar-thumb:active {
  background: var(--scroll-active);
}
body {
  overflow-x: clip;
}
a,
button {
  touch-action: manipulation;
}
button:active,
.fcl-button:active {
  transform: translateY(1px);
}
button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}
a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
summary:focus-visible {
  outline: 2px solid var(--green);
  outline-offset: 5px;
}
.studio-home .hero-copy {
  transform: none;
  width: auto;
  text-align: left;
}
.studio-home .slide-dots {
  position: static;
  transform: none;
  gap: 5px;
}
.studio-home .hero-bottom {
  justify-content: flex-start;
  gap: 25px;
  height: 44px;
}
.studio-home .slideshow-toggle {
  font-size: 12px;
  min-width: 44px;
  min-height: 44px;
  order: 2;
  border-bottom: 1px solid #ffffff60;
  color: #fff;
}
.studio-home .slide-arrow {
  color: #fff;
}
.studio-home .slide-arrow:hover {
  background: #186636;
}
.fcl-container {
  width: 100%;
  max-width: 1584px;
  padding-inline: var(--fcl-gutter);
  margin-inline: auto;
}
.fcl-section {
  padding-block: var(--fcl-section);
}
.fcl-label {
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0.075em;
  line-height: 1.6;
  text-transform: uppercase;
  display: block;
}
.fcl-muted {
  color: var(--muted-ink);
}
.fcl-lead {
  font-size: clamp(16px, 1.4vw, 20px);
  line-height: 1.85;
}
.fcl-arrow {
  flex: 0 0 24px;
  width: 24px;
  height: 24px;
  transition: transform 250ms var(--fcl-ease);
}
a:hover > .fcl-arrow,
button:hover > .fcl-arrow {
  transform: translate(3px, -2px);
}
.fcl-link {
  display: inline-flex;
  align-items: center;
  gap: 20px;
  width: fit-content;
  font-size: 14px;
  font-weight: 400;
  min-height: 44px;
  border-bottom: 1px solid currentColor;
  padding-block: 9px;
  transition: color 180ms;
}
.fcl-link:hover {
  color: var(--green);
}
.fcl-button {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
  min-height: 54px;
  padding: 15px 24px;
  background: var(--green);
  color: var(--bg);
  border: 1px solid var(--green);
  font-size: 14px;
  font-weight: 400;
  border-radius: 3px;
  transition:
    background 180ms,
    color 180ms;
}
.fcl-button:hover {
  background: var(--green-hover);
  border-color: var(--green-hover);
}
.studio-page {
  padding-top: 102px;
}
.studio-page h1,
.studio-page h2,
.studio-page h3 {
  font-family: var(--font-display), Arial, sans-serif;
  font-weight: 700;
  letter-spacing: -0.035em;
  line-height: 1.14;
  text-wrap: balance;
}
.studio-page h1 {
  font-size: clamp(40px, 5.8vw, 88px);
}
.studio-page h2 {
  font-size: clamp(30px, 3.2vw, 49px);
}
.studio-page h3 {
  font-size: clamp(23px, 2vw, 30px);
}
.studio-page p {
  color: var(--muted-ink);
}
.studio-page p + p {
  margin-top: 20px;
}
.studio-header {
  position: fixed;
  inset: 0 0 auto;
  z-index: 100;
  background: var(--header);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--line);
  transition: background 250ms;
}
.studio-nav {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 30px;
  max-width: 1584px;
  margin: auto;
  padding: 12px var(--fcl-gutter);
  height: 102px;
  transition:
    height 350ms var(--fcl-ease),
    padding 350ms var(--fcl-ease);
}
.studio-header.is-compact .studio-nav {
  height: 78px;
  padding-block: 5px;
}
.studio-brand {
  justify-self: start;
  display: block;
}
.studio-brand img {
  width: 78px;
  height: 72px;
  object-fit: contain;
  transition:
    width 350ms var(--fcl-ease),
    height 350ms var(--fcl-ease);
}
.studio-header.is-compact .studio-brand img {
  width: 65px;
  height: 61px;
}
.studio-primary {
  display: flex;
  gap: 38px;
  align-items: center;
}
.studio-primary > button {
  padding: 12px 0;
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 14px;
  position: relative;
  min-height: 44px;
}
.studio-primary > button:after {
  content: "";
  position: absolute;
  bottom: 6px;
  left: 0;
  right: 20px;
  height: 1px;
  background: currentColor;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 250ms var(--fcl-ease);
}
.studio-primary > button:hover:after,
.studio-primary > .current:after,
.studio-primary > [aria-expanded="true"]:after {
  transform: scaleX(1);
}
.nav-plus {
  font-size: 18px;
  line-height: 1;
  color: var(--green);
}
.studio-tools {
  display: flex;
  justify-self: end;
  align-items: center;
  gap: 4px;
}
.studio-icon,
.studio-menu-toggle {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  width: 44px;
  height: 44px;
  flex: 0 0 44px;
  padding: 11px;
  border-radius: 50%;
  transition: background 180ms;
}
.studio-icon:hover,
.studio-menu-toggle:hover {
  background: var(--section);
}
.studio-icon svg {
  width: 22px;
  height: 22px;
}
.studio-menu-toggle {
  display: none;
}
.studio-menu-toggle > span {
  width: 21px;
  display: grid;
  gap: 6px;
}
.studio-menu-toggle i {
  height: 1px;
  width: 21px;
  background: var(--ink);
  transition: transform 250ms;
}
.studio-menu-toggle .open i:first-child {
  transform: translateY(3.5px) rotate(45deg);
}
.studio-menu-toggle .open i:last-child {
  transform: translateY(-3.5px) rotate(-45deg);
}
.studio-menu[hidden] {
  display: none;
}
.studio-menu {
  border-top: 1px solid var(--line);
  background: var(--bg);
  max-height: calc(100svh - 78px);
  overflow-y: auto;
  overscroll-behavior: contain;
  animation: menu-reveal 450ms var(--fcl-ease) both;
}
.studio-menu-inner {
  display: grid;
  grid-template-columns: 1fr 1.8fr;
  gap: 10%;
  max-width: 1584px;
  margin: auto;
  padding: 48px var(--fcl-gutter) 64px;
}
.menu-statement > p {
  font-family: var(--font-display), sans-serif;
  font-size: clamp(30px, 3.3vw, 50px);
  line-height: 1.1;
  letter-spacing: -0.035em;
  margin: 30px 0;
}
.studio-menu-content {
  display: grid;
  gap: 28px;
}
.menu-link-heading {
  display: flex;
  gap: 30px;
  justify-content: space-between;
}
.menu-link-heading > a {
  display: flex;
  gap: 24px;
  align-items: center;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 22px;
}
.menu-solution-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 36px;
}
.menu-solution-grid > a {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 14px 0;
  border-bottom: 1px solid var(--line);
  font-size: 14px;
  min-height: 52px;
}
.studio-menu a:hover {
  color: var(--green);
}
.menu-solution-grid .fcl-arrow {
  width: 16px;
  flex-basis: 16px;
}
.menu-company-links {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 36px;
}
.menu-company-links > a {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  font-family: var(--font-display);
  font-size: 23px;
  border-bottom: 1px solid var(--line);
  padding: 18px 0;
}
.menu-company-links > a > span {
  font-size: 14px;
  font-family: var(--font-body);
}
.menu-large-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-family: var(--font-display);
  font-size: clamp(24px, 3vw, 42px);
  line-height: 1.2;
  letter-spacing: -0.025em;
}
.studio-menu-content > .fcl-muted {
  max-width: 500px;
  font-size: 14px;
}
@keyframes menu-reveal {
  from {
    clip-path: inset(0 0 100% 0);
    transform: translateY(-8px);
  }
  to {
    clip-path: inset(0);
    transform: translateY(0);
  }
}
.fcl-breadcrumbs {
  display: flex;
  gap: 12px;
  align-items: center;
  flex-wrap: wrap;
  padding-top: 30px;
  font-size: 12px;
  color: var(--muted-ink);
  line-height: 1.8;
}
.fcl-breadcrumbs > span {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}
.fcl-breadcrumbs a:hover {
  color: var(--green);
  text-decoration: underline;
}
.fcl-page-intro {
  padding-top: 68px;
  padding-bottom: 70px;
  display: grid;
  grid-template-columns: 1fr 3fr;
  gap: 40px;
}
.fcl-page-intro > .fcl-label {
  padding-top: 10px;
}
.fcl-page-intro h1 {
  max-width: 1000px;
}
.fcl-page-intro > div > p {
  font-size: 16px;
  line-height: 1.85;
  max-width: 630px;
  margin-top: 30px;
}
.fcl-page-intro + .fcl-section {
  padding-top: 25px;
}
.fcl-section-top {
  display: grid;
  grid-template-columns: 1fr 2.15fr auto;
  gap: 35px;
  align-items: start;
  margin-bottom: 54px;
}
.fcl-section-top > .fcl-label {
  padding-top: 8px;
}
.fcl-section-top > div > p {
  max-width: 510px;
  margin-top: 22px;
  font-size: 16px;
}
.fcl-section-top > .fcl-link {
  align-self: end;
  white-space: nowrap;
}
.fcl-photo {
  position: relative;
  aspect-ratio: 1.6;
  overflow: hidden;
  background: var(--section);
}
.fcl-photo img {
  object-fit: cover;
  transition: transform 650ms var(--fcl-ease);
}
a:hover .fcl-photo img {
  transform: scale(1.025);
}
.image-caption {
  display: block;
  color: var(--muted-ink);
  font-size: 12px;
  margin-top: 12px;
}
.fcl-contact-band {
  background: var(--section);
  border-block: 1px solid var(--line);
  padding-block: 60px;
}
.fcl-contact-band > .fcl-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 48px;
}
.fcl-contact-band h2 {
  max-width: 800px;
  font-size: clamp(30px, 3.1vw, 47px);
}
.fcl-contact-band .fcl-button {
  flex-shrink: 0;
}
.home-intro-line {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding-block: 23px;
  font-size: 12px;
  letter-spacing: 0.045em;
}
.studio-home .hero {
  height: min(780px, calc(100svh - 102px));
  min-height: 560px;
  margin: 0;
  width: 100%;
  max-width: none;
  background: #15251c;
}
.studio-home .hero-copy {
  left: var(--fcl-gutter);
  right: var(--fcl-gutter);
  bottom: 100px;
  max-width: 1300px;
}
.studio-home .hero-copy h1,
.studio-home .hero-copy h2 {
  font-family: var(--font-hero), Arial, sans-serif;
  font-size: clamp(35px, 4.9vw, 74px);
  line-height: 1.08;
  font-weight: 400;
  letter-spacing: -0.035em;
  max-width: 1150px;
  text-wrap: balance;
}
.studio-home .hero-copy p {
  color: #fff;
  font-size: clamp(14px, 1.25vw, 18px);
  margin-top: 25px;
}
.studio-home .hero-copy .button {
  margin-top: 26px;
  min-height: 50px;
  border-radius: 3px;
  font-size: 14px;
  padding: 14px 24px;
  background: #186636;
  color: white;
}
.studio-home .hero-copy .button:hover {
  background: #124f29;
}
.studio-home .hero-slide:after {
  background: linear-gradient(
    0deg,
    rgba(0, 0, 0, 0.65),
    rgba(0, 0, 0, 0.05) 85%
  );
}
.studio-home .slide-arrow {
  width: 44px;
  height: 44px;
  top: 48%;
  background: rgba(0, 0, 0, 0.22);
  border-color: rgba(255, 255, 255, 0.5);
}
.studio-home .slide-arrow.previous {
  left: 12px;
}
.studio-home .slide-arrow.next {
  right: 12px;
}
.studio-home .hero-bottom {
  bottom: 34px;
  left: var(--fcl-gutter);
}
.studio-home .company-panel {
  background: #0c0c0c;
}
.studio-home .company-copy p {
  color: #e4efe6;
}
.studio-home .company-copy h2 {
  color: white;
}
.studio-home .company-copy h2 span {
  color: white;
}
.studio-home .company-stats {
  color: white;
}
.studio-home .company-stats dd {
  color: #d1e0d3;
}
.studio-home .company-stats {
  grid-template-columns: 1fr 1fr 1fr;
}
.studio-home .company-copy .light-link {
  color: #fff;
}
.studio-home .partner-caption {
  color: #e5f0e7;
}
.studio-home .partner-billboard {
  background: #fff;
}
.studio-home .company-inner {
  padding-block: 78px;
}
.studio-home .company-stats dt {
  font-size: clamp(38px, 4vw, 62px);
}
.home-sectors {
  background: var(--section);
}
.home-sector-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 13%;
}
.home-sector-inner h2 {
  margin-top: 30px;
}
.home-sector-inner p {
  max-width: 460px;
  margin-top: 25px;
}
.home-sector-inner .fcl-link {
  margin-top: 30px;
}
.home-sector-list {
  display: grid;
  align-content: start;
}
.home-sector-list > a {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  min-height: 60px;
  padding-block: 15px;
  font-family: var(--font-display);
  font-size: 20px;
  letter-spacing: -0.025em;
  border-bottom: 1px solid var(--line);
}
.home-sector-list > a:hover {
  color: var(--green);
}
.solution-index {
  padding-bottom: var(--fcl-section);
}
.solution-group {
  padding-top: 56px;
  margin-top: 30px;
  border-top: 1px solid var(--line);
}
.solution-group > h2 {
  font-size: 28px;
  margin-bottom: 35px;
}
.solution-editorial-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 55px 55px;
}
.solution-editorial .fcl-photo {
  aspect-ratio: 1.9;
}
.solution-editorial > .fcl-label {
  margin-top: 24px;
  color: var(--muted-ink);
}
.solution-editorial h3 {
  display: flex;
  justify-content: space-between;
  align-items: start;
  gap: 25px;
  font-size: 28px;
  margin-top: 10px;
}
.solution-editorial p {
  margin-top: 15px;
  font-size: 16px;
}
.solution-editorial:hover h3 {
  color: var(--green);
}
.solution-detail-intro {
  padding-block: 62px 55px;
}
.solution-detail-intro > h1 {
  max-width: 1100px;
  margin-top: 26px;
}
.solution-detail-intro > div {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 30px;
  margin-top: 28px;
}
.solution-detail-intro > div > p {
  font-size: 21px;
  color: var(--ink);
  font-family: var(--font-display);
}
.solution-detail-intro > div > .fcl-label {
  color: var(--green);
}
.solution-detail-visual .fcl-photo {
  aspect-ratio: 2.6;
  max-height: 540px;
}
.solution-detail-visual img {
  object-fit: contain;
  background: #fff;
}
.detail-explanation {
  display: grid;
  grid-template-columns: 1fr 1.65fr;
  gap: 12%;
}
.detail-explanation .fcl-lead {
  margin-top: 25px;
}
.detail-explanation .fcl-link {
  margin-top: 25px;
}
.detail-explanation > div > h2 {
  margin-top: 22px;
}
.detail-explanation > div > h2:first-child {
  margin-top: 0;
}
.detail-explanation > div > p:not(.fcl-lead) {
  margin-top: 22px;
}
.detail-capability-band {
  background: var(--section);
}
.capability-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.capability-list > li {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 25px;
  padding: 23px 0;
  border-bottom: 1px solid var(--line);
  font-size: 16px;
}
.capability-list > li:first-child {
  padding-top: 0;
}
.capability-list > li > span {
  color: var(--green);
}
.sector-chips {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 30px;
}
.sector-chips > a {
  display: flex;
  gap: 18px;
  align-items: center;
  font-size: 14px;
  border: 1px solid var(--line);
  padding: 12px 15px;
  min-height: 44px;
  transition: background 180ms;
}
.sector-chips > a:hover {
  background: var(--section);
}
.sector-chips .fcl-arrow {
  width: 16px;
  flex-basis: 16px;
}
.related-solutions {
  border-top: 1px solid var(--line);
}
.related-solutions > h2 {
  margin-top: 25px;
  margin-bottom: 30px;
}
.fcl-solution-links > a {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
  padding: 26px 0;
  border-bottom: 1px solid var(--line);
  font-family: var(--font-display);
  font-size: clamp(22px, 2.6vw, 36px);
  line-height: 1.3;
  letter-spacing: -0.025em;
}
.fcl-solution-links > a:hover {
  color: var(--green);
}
.fcl-solution-links small {
  display: block;
  font-family: var(--font-body);
  font-size: 12px;
  letter-spacing: 0;
  color: var(--muted-ink);
  margin-bottom: 8px;
}
.profile-download-row {
  padding-block: 30px;
  display: flex;
  gap: 35px;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid var(--line);
  font-size: 14px;
}
.profile-download-row + .fcl-contact-band {
  margin-top: 30px;
}
.sector-index {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 54px 35px;
}
@media (min-width: 901px) {
  .sector-tile:first-child {
    grid-column: 1/-1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 48px;
    align-content: center;
  }
  .sector-tile:first-child .fcl-photo {
    grid-row: 1/3;
  }
  .sector-tile:first-child h2 {
    margin-top: 0;
    align-self: end;
  }
  .sector-tile:first-child > p {
    margin-top: 20px;
    max-width: 520px;
    align-self: start;
  }
}
.sector-tile .fcl-photo {
  aspect-ratio: 1.6;
}
.sector-tile h2 {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  align-items: start;
  font-size: 24px;
  margin-top: 23px;
}
.sector-tile h2 > .fcl-arrow {
  width: 19px;
  flex-basis: 19px;
}
.sector-tile > p {
  font-size: 16px;
  margin-top: 14px;
}
.sector-tile:hover h2 {
  color: var(--green);
}
.sector-detail {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9%;
  align-items: center;
}
.sector-detail .fcl-photo {
  aspect-ratio: 1.6;
}
.sector-detail h2 {
  margin-top: 22px;
}
.sector-detail p {
  margin-top: 25px;
}
.sector-detail .fcl-link {
  margin-top: 20px;
}
.about-opening {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9%;
  align-items: center;
}
.about-opening > .fcl-photo {
  aspect-ratio: 0.95;
}
.about-opening > div > h2 {
  margin-top: 24px;
}
.about-opening p {
  font-size: 16px;
  margin-top: 24px;
}
.about-opening .fcl-link {
  margin-top: 20px;
}
.about-figures {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 30px;
}
.about-figures > div {
  display: grid;
  gap: 12px;
  border-top: 1px solid var(--line);
  padding-top: 30px;
}
.about-figures strong {
  font-family: var(--font-display);
  font-size: clamp(55px, 7.5vw, 115px);
  font-weight: 700;
  letter-spacing: -0.06em;
  line-height: 1;
  color: var(--green);
}
.about-figures span {
  font-size: 14px;
}
.about-figures > p {
  grid-column: 1/-1;
  font-size: 16px;
  margin-top: 0;
}
.about-purpose {
  background: var(--section);
}
.purpose-rows > article {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 40px;
  padding: 30px 0;
  border-bottom: 1px solid var(--line);
}
.purpose-rows h3 {
  font-size: 25px;
}
.purpose-rows p {
  font-size: 16px;
  max-width: 700px;
}
.detail-explanation .purpose-rows > article {
  display: block;
}
.detail-explanation .purpose-rows p {
  margin-top: 16px;
}
.detail-explanation .purpose-rows > article:first-child {
  padding-top: 0;
}
.service-process {
  padding-bottom: var(--fcl-section);
}
.process-stage {
  display: grid;
  grid-template-columns: 0.25fr 1.5fr 1fr;
  gap: 55px;
  border-top: 1px solid var(--line);
  padding: 52px 0;
  align-items: start;
}
.process-number {
  font-size: 14px;
  color: var(--green);
}
.process-stage h2 {
  font-size: 37px;
}
.process-stage p {
  max-width: 620px;
  font-size: 16px;
  line-height: 1.9;
  margin-top: 25px;
}
.process-stage .fcl-photo {
  aspect-ratio: 1.35;
}
.process-stage .fcl-link {
  margin-top: 22px;
}
.partner-directory {
  padding-top: 0;
}
.partner-directory article {
  display: grid;
  grid-template-columns: 220px 1fr auto;
  gap: 60px;
  align-items: center;
  padding-block: 34px;
  border-top: 1px solid var(--line);
}
.partner-logo-well {
  background: #fff;
  padding: 22px 28px;
  height: 100px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.partner-logo-well > img {
  width: 100%;
  height: auto;
  max-height: 65px;
  object-fit: contain;
}
.partner-directory h2 {
  font-size: 28px;
}
.partner-directory p {
  font-size: 16px;
  margin-top: 8px;
}
.client-name-directory {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0 30px;
  padding-top: 0;
}
.client-name-directory > span {
  display: flex;
  align-items: center;
  min-height: 100px;
  font-family: var(--font-display);
  font-size: 19px;
  font-weight: 700;
  line-height: 1.35;
  padding-block: 24px;
  border-top: 1px solid var(--line);
  letter-spacing: -0.025em;
}
.project-gallery {
  padding-bottom: var(--fcl-section);
}
.project-toolbar {
  display: flex;
  gap: 40px;
  align-items: start;
  justify-content: space-between;
  border-block: 1px solid var(--line);
  padding: 24px 0;
}
.fcl-filter-group {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.fcl-filter-group > button {
  padding: 10px 14px;
  border: 1px solid transparent;
  min-height: 44px;
  font-size: 12px;
  border-radius: 2px;
}
.fcl-filter-group > button:hover {
  background: var(--section);
}
.fcl-filter-group > [aria-pressed="true"] {
  background: var(--green);
  color: var(--bg);
}
.project-search {
  display: flex;
  align-items: center;
  min-width: 230px;
  border-bottom: 1px solid var(--ink);
}
.project-search input {
  width: 100%;
  background: none;
  border: 0;
  padding: 12px 0;
  font-size: 14px;
  min-width: 0;
  outline-offset: 0;
}
.project-search button {
  font-size: 12px;
  min-height: 44px;
}
.result-count {
  margin: 18px 0 32px;
  font-size: 12px;
}
.reference-grid {
  display: block;
  border-top: 1px solid var(--line);
}
.reference-project {
  display: grid;
  grid-template-columns: 240px minmax(0, 1fr);
  gap: 8px 40px;
  padding-block: 30px;
  border-bottom: 1px solid var(--line);
}
.reference-project .reference-image {
  grid-column: 1;
  grid-row: 1/4;
  width: 100%;
  max-width: 240px;
  aspect-ratio: 315/154;
  align-self: center;
}
.reference-project > :not(.reference-image) {
  grid-column: 2;
}
.reference-image {
  overflow: hidden;
  background: var(--section);
  aspect-ratio: 315/154;
}
.reference-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 600ms var(--fcl-ease);
}
.reference-project:hover img {
  transform: scale(1.025);
}
.reference-project > .fcl-label {
  margin-top: 0;
  color: var(--muted-ink);
}
.reference-project h2 {
  font-size: 24px;
  line-height: 1.25;
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-top: 0;
}
.reference-project h2 > .fcl-arrow {
  width: 18px;
  flex-basis: 18px;
}
.reference-project p {
  font-size: 16px;
  margin-top: 0;
  max-width: 720px;
}
.reference-detail {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12%;
  align-items: start;
  padding-top: 0;
}
.reference-detail figure {
  margin: 0;
  max-width: 530px;
}
.reference-detail .fcl-photo {
  aspect-ratio: 315/154;
}
.reference-detail figcaption {
  font-size: 12px;
  color: var(--muted-ink);
  margin-top: 15px;
}
.reference-detail dl > div,
.enquiry-review dl > div {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 20px;
  padding: 15px 0;
  border-bottom: 1px solid var(--line);
  font-size: 14px;
}
.reference-detail dt,
.enquiry-review dt {
  color: var(--muted-ink);
}
.reference-detail dd {
  text-transform: capitalize;
}
.reference-detail > div > p {
  font-size: 16px;
  margin-top: 28px;
}
.reference-detail .fcl-link {
  display: flex;
  margin-top: 20px;
  font-size: 14px;
}
.project-next {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 50px;
  border-top: 1px solid var(--line);
  padding-block: 45px;
}
.project-next > a:last-child {
  max-width: 70%;
}
.project-next h2 {
  font-size: 25px;
  margin-top: 15px;
  display: flex;
  align-items: center;
  gap: 30px;
}
.gallery-loading {
  min-height: 650px;
  padding-top: 30px;
}
.fcl-empty {
  padding-block: 110px;
  min-height: 400px;
}
.fcl-empty > h1,
.fcl-empty > h2 {
  margin-block: 20px;
}
.fcl-empty > .fcl-button {
  margin-top: 30px;
}
.contact-layout {
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: 13%;
  padding-top: 10px;
}
.contact-aside h2 {
  margin: 25px 0 35px;
}
.contact-aside address {
  font-style: normal;
  line-height: 1.85;
  font-size: 16px;
}
.contact-aside > div {
  display: grid;
  gap: 9px;
  margin-top: 35px;
}
.contact-aside > div > a {
  width: fit-content;
  font-size: 14px;
}
.contact-aside > div > a:hover {
  color: var(--green);
  text-decoration: underline;
}
.contact-aside > .fcl-link {
  margin-top: 30px;
}
.enquiry-form {
  border-top: 1px solid var(--line);
  padding-top: 28px;
}
.form-heading > h2 {
  font-size: 35px;
  margin-top: 18px;
}
.form-heading > p {
  font-size: 16px;
  max-width: 500px;
  margin-top: 20px;
}
.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 28px;
  margin-top: 35px;
}
.form-field {
  display: grid;
  gap: 10px;
  margin-bottom: 24px;
}
.form-field > label {
  font-size: 14px;
  font-weight: 400;
}
.form-field input,
.form-field select,
.form-field textarea {
  width: 100%;
  min-width: 0;
  background: var(--bg);
  border: 1px solid var(--line);
  color: var(--ink);
  padding: 13px 14px;
  font: inherit;
  font-size: 14px;
  border-radius: 2px;
  min-height: 50px;
  transition: border-color 180ms;
}
.form-field textarea {
  resize: none;
  line-height: 1.7;
}
.form-field select {
  cursor: pointer;
}
.form-field [aria-invalid="true"] {
  border-color: var(--red);
}
.field-error {
  font-size: 12px;
  line-height: 1.5;
  color: #b21a20;
  min-height: 16px;
}
.field-help {
  font-size: 12px;
  color: var(--muted-ink);
}
.enquiry-review > h2 {
  margin-top: 20px;
}
.enquiry-review > p {
  font-size: 16px;
  margin-top: 25px;
}
.enquiry-review dl {
  margin-top: 25px;
}
.enquiry-review dd {
  overflow-wrap: anywhere;
}
.review-message {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  border: 1px solid var(--line);
  padding: 24px;
  background: var(--section);
}
.review-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  align-items: center;
  margin-top: 30px;
}
.careers-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10%;
  align-items: start;
  padding-top: 10px;
}
.careers-layout > div > h2 {
  margin-top: 25px;
}
.careers-layout p {
  font-size: 16px;
  margin-top: 25px;
}
.careers-layout .fcl-link {
  margin-top: 20px;
}
.career-enquiry {
  border-top: 1px solid var(--line);
  padding-top: 35px;
  margin-top: 45px;
}
.career-enquiry > h3 {
  font-size: 25px;
}
.career-enquiry > .fcl-button {
  margin-top: 25px;
}
.global-footer {
  background: #0c0c0c;
  color: #fff;
  padding-top: 80px;
}
.footer-top {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 10%;
  padding-bottom: 75px;
  border-bottom: 1px solid #ffffff30;
}
.footer-invitation {
  display: block;
  font-family: var(--font-display);
  font-size: clamp(56px, 7vw, 108px);
  line-height: 1.02;
  letter-spacing: -0.06em;
  margin-top: 32px;
  font-weight: 700;
  position: relative;
  width: fit-content;
}
.footer-invitation > .fcl-arrow {
  width: clamp(35px, 5vw, 72px);
  height: auto;
  margin-left: 35px;
  vertical-align: baseline;
}
.footer-invitation:hover {
  color: #a5d9b5;
}
.footer-contact {
  align-self: end;
  display: grid;
  gap: 12px;
  font-size: 18px;
}
.footer-contact > a:hover {
  text-decoration: underline;
}
.footer-contact address {
  font-size: 16px;
  font-style: normal;
  color: #bed0c3;
  margin-top: 18px;
  line-height: 1.8;
}
.footer-directory {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1.3fr;
  gap: 45px;
  padding-block: 58px;
}
.footer-directory > div {
  display: flex;
  flex-direction: column;
  gap: 12px;
  font-size: 14px;
}
.footer-directory .fcl-label {
  color: #a9c1b1;
  margin-bottom: 15px;
}
.footer-directory a:not(.footer-wordmark):hover {
  color: #a5d9b5;
  text-decoration: underline;
}
.footer-wordmark {
  font-family: var(--font-hero);
  font-size: 50px;
  line-height: 1;
  letter-spacing: -0.045em;
  width: fit-content;
}
.footer-wordmark span {
  display: block;
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0.14em;
  margin-top: 9px;
}
.footer-directory > div > p {
  font-size: 16px;
  color: #bed0c3;
  margin-top: 10px;
}
.footer-bottom {
  border-top: 1px solid #ffffff30;
  padding-block: 25px;
  display: flex;
  gap: 25px;
  justify-content: space-between;
  font-size: 12px;
  color: #bed0c3;
}
.footer-bottom > span {
  letter-spacing: 0.05em;
}
.studio-search {
  width: min(760px, calc(100vw - 32px));
  max-height: 85svh;
  padding: 32px;
  background: var(--bg);
  color: var(--ink);
  border: 1px solid var(--line);
  border-radius: 4px;
  margin: auto;
  overflow: auto;
  overscroll-behavior: contain;
}
.studio-search::backdrop {
  background: #07130d99;
}
.studio-search[open] {
  animation: menu-reveal 250ms var(--fcl-ease);
}
body:has(.studio-search[open]) {
  overflow: hidden;
}
.search-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}
.search-top h2 {
  font-family: var(--font-display);
  font-size: 30px;
  letter-spacing: -0.035em;
}
.search-top .studio-icon {
  font-size: 28px;
}
.search-field {
  display: flex;
  gap: 10px;
  border-bottom: 1px solid var(--ink);
  margin-block: 24px 16px;
  align-items: center;
}
.search-field input {
  min-width: 0;
  width: 100%;
  background: none;
  border: 0;
  color: var(--ink);
  font: inherit;
  font-size: 16px;
  padding: 15px 0;
}
.search-field > button {
  font-size: 14px;
  min-height: 44px;
}
.studio-search > .fcl-muted {
  font-size: 12px;
  margin-bottom: 18px;
}
.search-results > a {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 0;
  border-bottom: 1px solid var(--line);
  gap: 20px;
  font-size: 15px;
}
.search-results > a:hover {
  color: var(--green);
}
.search-results small {
  display: block;
  font-size: 12px;
  text-transform: uppercase;
  color: var(--muted-ink);
  margin-bottom: 5px;
}
.search-empty {
  padding-block: 35px;
}
.search-empty p {
  margin-top: 15px;
  color: var(--muted-ink);
}
.search-empty .fcl-link {
  margin-top: 20px;
}
.product-gallery {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 30px;
  align-items: start;
}
.product-gallery > figure {
  margin: 0;
  min-width: 0;
}
.product-gallery > figure:first-child:nth-last-child(odd) {
  grid-column: 1/-1;
}
.product-gallery img {
  display: block;
  width: 100%;
  height: auto;
}
.product-gallery figcaption {
  font-size: 12px;
  color: var(--muted-ink);
  margin-top: 15px;
}
.product-gallery-note {
  font-size: 12px;
  margin-top: 30px !important;
}
.product-gallery-section {
  border-top: 1px solid var(--line);
}
.client-logo-board {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 20px;
  padding-block: 10px 60px;
}
.client-logo-board > div {
  background: #fff;
  padding: 14px;
  min-height: 80px;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 1px solid var(--line);
}
.client-logo-board img {
  width: 100%;
  max-width: 100px;
  height: auto;
  object-fit: contain;
}
.profile-browser {
  padding-bottom: var(--fcl-section);
}
.profile-browser-toolbar {
  display: flex;
  justify-content: space-between;
  gap: 30px;
  align-items: center;
  border-block: 1px solid var(--line);
  padding-block: 24px;
}
.profile-browser-toolbar > label {
  display: grid;
  gap: 8px;
  font-size: 12px;
  max-width: 55%;
}
.profile-browser-toolbar select {
  background: var(--bg);
  border: 1px solid var(--line);
  color: var(--ink);
  padding: 12px 15px;
  min-height: 48px;
  font-size: 14px;
  max-width: 100%;
  cursor: pointer;
}
.profile-controls {
  display: flex;
  gap: 15px;
  align-items: center;
  white-space: nowrap;
  font-size: 14px;
}
.profile-controls button {
  border: 1px solid var(--line);
  width: 44px;
  height: 44px;
}
.profile-controls button:hover:enabled {
  background: var(--section);
}
.profile-reader {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 8%;
  padding-top: 40px;
  align-items: start;
}
.profile-reader aside {
  position: sticky;
  top: 110px;
}
.profile-reader h2 {
  font-size: 30px;
  margin-top: 25px;
}
.profile-reader p {
  font-size: 16px;
  margin-top: 25px;
}
.profile-reader .fcl-link {
  font-size: 14px;
  margin-top: 20px;
}
.profile-reader figure {
  margin: 0;
  min-width: 0;
}
.profile-reader figure > img {
  width: 100%;
  height: auto;
  background: #fff;
  border: 1px solid var(--line);
}
.profile-reader figcaption {
  font-size: 12px;
  color: var(--muted-ink);
  margin-top: 12px;
}
@media (max-width: 900px) {
  .client-logo-board {
    grid-template-columns: repeat(4, 1fr);
  }
  .product-gallery {
    grid-template-columns: 1fr 1fr;
  }
  .profile-browser-toolbar {
    flex-wrap: wrap;
  }
  .profile-reader {
    gap: 6%;
  }
}
@media (max-width: 650px) {
  .product-gallery {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  .client-logo-board {
    gap: 10px;
    padding-bottom: 40px;
  }
  .client-logo-board > div {
    padding: 10px;
    min-height: 55px;
  }
  .profile-browser-toolbar {
    gap: 20px;
  }
  .profile-browser-toolbar > label {
    max-width: 100%;
    width: 100%;
  }
  .profile-reader {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  .profile-reader aside {
    position: static;
  }
  .profile-reader h2 {
    font-size: 26px;
  }
  .profile-browser-toolbar select {
    font-size: 14px;
  }
}
@media (min-width: 1600px) {
  .studio-home .hero-copy {
    left: max(var(--fcl-gutter), calc((100vw - 1440px) / 2));
  }
  .studio-home .hero-bottom {
    left: max(var(--fcl-gutter), calc((100vw - 1440px) / 2));
  }
}
@media (max-width: 1150px) {
  .studio-primary {
    gap: 24px;
  }
  .studio-nav {
    gap: 20px;
  }
  .fcl-section-top {
    grid-template-columns: 1fr 2.8fr;
  }
  .fcl-section-top > .fcl-link {
    grid-column: 2;
  }
  .partner-directory article {
    grid-template-columns: 170px 1fr;
    gap: 35px;
  }
  .partner-directory article > .fcl-link {
    grid-column: 2;
  }
  .client-name-directory {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .project-toolbar {
    flex-direction: column;
    gap: 20px;
  }
  .project-search {
    width: 100%;
  }
  .process-stage {
    grid-template-columns: 0.2fr 1.5fr 1fr;
    gap: 30px;
  }
  .footer-directory {
    gap: 30px;
  }
  .footer-directory > div:last-child {
    grid-column: auto;
  }
}
@media (max-width: 900px) {
  .studio-nav {
    grid-template-columns: 1fr auto;
    height: 84px;
  }
  .studio-page {
    padding-top: 84px;
  }
  .studio-header.is-compact .studio-nav {
    height: 72px;
  }
  .studio-brand img {
    width: 68px;
    height: 64px;
  }
  .studio-primary {
    display: none;
  }
  .studio-menu-toggle {
    display: flex;
  }
  .studio-menu-inner {
    grid-template-columns: 1fr;
    padding-block: 25px 40px;
  }
  .menu-statement {
    display: none;
  }
  .studio-menu {
    max-height: calc(100svh - 72px);
  }
  .studio-menu-content {
    gap: 30px;
  }
  .menu-company-links > a {
    font-size: 23px;
  }
  .studio-home .hero {
    height: calc(85svh - 84px);
    min-height: 510px;
  }
  .studio-home .hero-copy {
    bottom: 90px;
  }
  .studio-home .hero-copy h1,
  .studio-home .hero-copy h2 {
    font-size: clamp(34px, 5.7vw, 55px);
  }
  .studio-home .hero-copy p {
    font-size: 16px;
  }
  .studio-home .company-inner {
    grid-template-columns: 1fr;
    gap: 45px;
  }
  .studio-home .company-stats {
    gap: 25px;
  }
  .studio-home .company-stats > div {
    border-top: 1px solid #ffffff50;
    padding-top: 20px;
  }
  .home-sector-inner {
    gap: 8%;
  }
  .home-sector-list > a {
    font-size: 17px;
  }
  .fcl-page-intro {
    grid-template-columns: 1fr;
    gap: 25px;
    padding-top: 45px;
    padding-bottom: 50px;
  }
  .fcl-page-intro > .fcl-label {
    padding-top: 0;
  }
  .fcl-page-intro > div > p {
    margin-top: 25px;
  }
  .fcl-contact-band > .fcl-container {
    flex-direction: column;
    align-items: start;
    gap: 25px;
  }
  .detail-explanation {
    grid-template-columns: 1fr 1.5fr;
    gap: 8%;
  }
  .solution-detail-intro > div {
    align-items: start;
    flex-direction: column;
    gap: 15px;
  }
  .sector-index {
    grid-template-columns: 1fr 1fr;
  }
  .partner-directory article {
    grid-template-columns: 170px 1fr;
  }
  .contact-layout {
    grid-template-columns: 1fr 1.5fr;
    gap: 7%;
  }
  .footer-top {
    gap: 7%;
  }
  .footer-directory {
    grid-template-columns: 1.2fr 1fr 1fr;
  }
  .footer-directory > div:last-child {
    grid-column: 2/4;
  }
  .process-stage {
    grid-template-columns: 35px 1fr;
    gap: 25px;
  }
  .process-stage > .fcl-photo {
    grid-column: 2;
    max-width: 500px;
    aspect-ratio: 1.8;
  }
  .solution-editorial h3 {
    font-size: 25px;
  }
  .profile-download-row {
    flex-direction: column;
    align-items: start;
    gap: 15px;
  }
}
@media (max-width: 650px) {
  .studio-nav {
    gap: 10px;
    padding-block: 8px;
  }
  .studio-brand img {
    width: 64px;
    height: 60px;
  }
  .studio-tools {
    gap: 0;
  }
  .studio-icon,
  .studio-menu-toggle {
    width: 40px;
    height: 44px;
    flex-basis: 40px;
    padding: 10px;
  }
  .studio-menu-inner {
    padding-inline: 20px;
  }
  .menu-link-heading {
    gap: 20px;
  }
  .menu-link-heading > a {
    font-size: 18px;
    gap: 12px;
  }
  .menu-link-heading .fcl-arrow {
    width: 18px;
    flex-basis: 18px;
  }
  .menu-solution-grid {
    column-gap: 20px;
  }
  .menu-solution-grid > a {
    font-size: 12px;
    line-height: 1.5;
    gap: 10px;
    min-height: 60px;
  }
  .menu-solution-grid .fcl-arrow {
    width: 13px;
    flex-basis: 13px;
  }
  .menu-company-links {
    gap: 0 20px;
  }
  .menu-company-links > a {
    font-size: 20px;
  }
  .menu-company-links .fcl-arrow {
    width: 17px;
    flex-basis: 17px;
  }
  .studio-page h1 {
    font-size: clamp(36px, 9vw, 56px);
  }
  .studio-page h2 {
    font-size: 32px;
  }
  .fcl-label {
    font-size: 12px;
  }
  .fcl-page-intro {
    padding-top: 36px;
    padding-bottom: 42px;
  }
  .fcl-page-intro > div > p {
    font-size: 16px;
  }
  .fcl-breadcrumbs {
    padding-top: 24px;
    font-size: 12px;
    gap: 8px;
  }
  .fcl-breadcrumbs > span {
    gap: 8px;
  }
  .fcl-section-top {
    grid-template-columns: 1fr;
    gap: 23px;
    margin-bottom: 32px;
  }
  .fcl-section-top > .fcl-link {
    grid-column: auto;
    font-size: 14px;
  }
  .fcl-section-top > div > p {
    font-size: 16px;
    margin-top: 20px;
  }
  .fcl-contact-band {
    padding-block: 40px;
  }
  .fcl-contact-band h2 {
    font-size: 30px;
  }
  .fcl-contact-band .fcl-button {
    font-size: 14px;
  }
  .studio-home .hero {
    min-height: 540px;
    height: calc(86svh - 84px);
    max-height: 760px;
  }
  .studio-home .hero-copy {
    left: 20px;
    right: 20px;
    bottom: 100px;
  }
  .studio-home .hero-copy h1,
  .studio-home .hero-copy h2 {
    font-size: clamp(29px, 6.9vw, 44px);
    line-height: 1.13;
    text-wrap: initial;
  }
  .studio-home .hero-copy p {
    font-size: 16px;
    max-width: 320px;
    margin-top: 24px;
    line-height: 1.8;
  }
  .studio-home .hero-copy .button {
    font-size: 12px;
    min-height: 46px;
    margin-top: 22px;
  }
  .studio-home .slide-arrow {
    top: auto;
    bottom: 24px;
    width: 40px;
    height: 40px;
    transform: none;
  }
  .studio-home .slide-arrow.previous {
    left: auto;
    right: 68px;
  }
  .studio-home .slide-arrow.next {
    right: 20px;
  }
  .studio-home .hero-bottom {
    left: 20px;
    bottom: 38px;
  }
  .home-intro-line {
    font-size: 12px;
    padding-block: 20px;
    align-items: center;
  }
  .home-intro-line > span:first-child {
    max-width: 180px;
  }
  .home-intro-line > span:last-child {
    text-align: right;
    max-width: 100px;
  }
  .studio-home .company-inner {
    padding-block: 55px;
    gap: 40px;
  }
  .studio-home .company-copy h2 {
    font-size: 31px;
  }
  .studio-home .company-copy p {
    font-size: 16px;
    line-height: 1.9;
  }
  .studio-home .company-stats {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 15px;
  }
  .studio-home .company-stats dt {
    font-size: 36px;
  }
  .studio-home .company-stats dd {
    font-size: 16px;
    line-height: 1.6;
    margin-top: 10px;
  }
  .studio-home .company-stats > div {
    padding-top: 16px;
  }
  .studio-home .company-stats dt span {
    font-size: 22px;
  }
  .home-sector-inner {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .home-sector-inner h2 {
    margin-top: 22px;
  }
  .home-sector-inner p {
    font-size: 16px;
    margin-top: 22px;
  }
  .home-sector-inner .fcl-link {
    margin-top: 22px;
  }
  .home-sector-list > a {
    font-size: 19px;
    min-height: 60px;
  }
  .solution-group {
    padding-top: 35px;
    margin-top: 10px;
  }
  .solution-group > h2 {
    font-size: 24px;
    margin-bottom: 28px;
  }
  .solution-editorial-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .solution-editorial h3 {
    font-size: 26px;
  }
  .solution-editorial p {
    font-size: 16px;
  }
  .solution-editorial > .fcl-label {
    margin-top: 20px;
  }
  .solution-detail-intro {
    padding-block: 40px;
  }
  .solution-detail-intro h1 {
    margin-top: 20px;
    font-size: clamp(35px, 8.8vw, 50px);
  }
  .solution-detail-intro > div > p {
    font-size: 18px;
  }
  .solution-detail-visual .fcl-photo {
    aspect-ratio: 1.55;
  }
  .detail-explanation {
    grid-template-columns: 1fr;
    gap: 32px;
  }
  .detail-explanation > div > h2 {
    margin-top: 20px;
  }
  .detail-explanation .fcl-lead {
    font-size: 15px;
    line-height: 1.9;
    margin-top: 22px;
  }
  .detail-explanation > div > p:not(.fcl-lead) {
    font-size: 16px;
  }
  .capability-list > li {
    font-size: 14px;
    gap: 20px;
    padding-block: 20px;
  }
  .capability-list > li:first-child {
    padding-top: 10px;
  }
  .fcl-solution-links > a {
    font-size: 25px;
    gap: 20px;
    padding-block: 24px;
  }
  .sector-chips > a {
    font-size: 12px;
    gap: 12px;
  }
  .sector-index {
    grid-template-columns: 1fr;
    gap: 38px;
  }
  .sector-tile h2 {
    font-size: 25px;
    margin-top: 19px;
  }
  .sector-tile p {
    font-size: 16px;
  }
  .sector-detail {
    grid-template-columns: 1fr;
    gap: 35px;
  }
  .sector-detail .fcl-photo {
    aspect-ratio: 1.6;
  }
  .about-opening {
    grid-template-columns: 1fr;
    gap: 35px;
  }
  .about-opening > .fcl-photo {
    aspect-ratio: 1.3;
  }
  .about-opening > div > h2 {
    font-size: 33px;
  }
  .about-opening p {
    font-size: 16px;
  }
  .about-figures {
    gap: 18px;
  }
  .about-figures strong {
    font-size: clamp(38px, 10vw, 64px);
  }
  .about-figures span {
    font-size: 12px;
  }
  .about-figures > p {
    font-size: 16px;
  }
  .purpose-rows > article {
    grid-template-columns: 1fr;
    gap: 16px;
    padding-block: 25px;
  }
  .purpose-rows h3 {
    font-size: 25px;
  }
  .purpose-rows p {
    font-size: 16px;
  }
  .process-stage {
    gap: 20px;
    grid-template-columns: 25px 1fr;
    padding-block: 35px;
  }
  .process-stage h2 {
    font-size: 28px;
  }
  .process-stage p {
    font-size: 16px;
    margin-top: 18px;
  }
  .process-stage > .fcl-photo {
    max-width: none;
  }
  .partner-directory article {
    grid-template-columns: 100px 1fr;
    gap: 20px;
    padding-block: 25px;
  }
  .partner-logo-well {
    height: 70px;
    padding: 12px;
  }
  .partner-directory h2 {
    font-size: 23px;
  }
  .partner-directory p {
    font-size: 16px;
  }
  .partner-directory article > .fcl-link {
    font-size: 12px;
    margin-top: -5px;
  }
  .client-name-directory {
    grid-template-columns: 1fr 1fr;
    gap: 0 22px;
  }
  .client-name-directory > span {
    font-size: 16px;
    min-height: 95px;
  }
  .reference-project {
    display: block;
    padding-block: 28px;
  }
  .reference-project .reference-image {
    max-width: 315px;
    margin-bottom: 22px;
  }
  .reference-project h2 {
    margin-top: 10px;
  }
  .reference-project p {
    margin-top: 12px;
  }
  .reference-project h2 {
    font-size: 25px;
  }
  .reference-project p {
    font-size: 16px;
  }
  .reference-image {
    aspect-ratio: 1.9;
  }
  .project-toolbar {
    gap: 15px;
    padding-block: 15px;
  }
  .fcl-filter-group {
    gap: 3px;
  }
  .fcl-filter-group > button {
    font-size: 12px;
    padding: 10px 12px;
  }
  .reference-detail {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  .reference-detail .fcl-photo {
    aspect-ratio: 1.8;
  }
  .reference-detail dl > div {
    font-size: 14px;
  }
  .reference-detail > div > p {
    font-size: 16px;
  }
  .project-next {
    align-items: start;
    flex-direction: column;
    gap: 30px;
    padding-block: 30px;
  }
  .project-next > a:last-child {
    max-width: none;
  }
  .project-next h2 {
    font-size: 24px;
    gap: 20px;
  }
  .contact-layout {
    grid-template-columns: 1fr;
    gap: 50px;
  }
  .contact-aside h2 {
    font-size: 34px;
    margin-bottom: 25px;
  }
  .contact-aside > div {
    margin-top: 25px;
  }
  .contact-aside > div > a {
    min-height: 30px;
  }
  .form-heading > h2 {
    font-size: 30px;
  }
  .form-grid {
    gap: 0 20px;
    margin-top: 30px;
  }
  .form-field {
    margin-bottom: 20px;
  }
  .form-field > label {
    font-size: 12px;
  }
  .form-field input,
  .form-field textarea,
  .form-field select {
    font-size: 16px;
  }
  .enquiry-review > h2 {
    font-size: 30px;
  }
  .careers-layout {
    grid-template-columns: 1fr;
    gap: 35px;
  }
  .careers-layout .fcl-photo {
    aspect-ratio: 1.8;
  }
  .careers-layout p {
    font-size: 16px;
  }
  .career-enquiry {
    margin-top: 30px;
    padding-top: 30px;
  }
  .career-enquiry > h3 {
    font-size: 24px;
  }
  .global-footer {
    padding-top: 55px;
  }
  .footer-top {
    grid-template-columns: 1fr;
    gap: 38px;
    padding-bottom: 40px;
  }
  .footer-top .fcl-label {
    font-size: 12px;
  }
  .footer-invitation {
    font-size: 70px;
    margin-top: 25px;
  }
  .footer-invitation .fcl-arrow {
    width: 45px;
    margin-left: 25px;
  }
  .footer-contact {
    font-size: 16px;
    gap: 10px;
  }
  .footer-contact address {
    font-size: 16px;
    margin-top: 12px;
  }
  .footer-directory {
    grid-template-columns: 1fr 1fr;
    gap: 35px 25px;
    padding-block: 35px;
  }
  .footer-directory > div:first-child {
    grid-column: 1/-1;
  }
  .footer-directory > div:last-child {
    grid-column: 1/-1;
  }
  .footer-directory .fcl-label {
    font-size: 12px;
    margin-bottom: 5px;
  }
  .footer-directory > div {
    font-size: 12px;
    gap: 12px;
  }
  .footer-wordmark {
    font-size: 44px;
  }
  .footer-directory > div > p {
    font-size: 16px;
  }
  .footer-bottom {
    font-size: 12px;
    gap: 15px;
    align-items: start;
  }
  .footer-bottom > span {
    max-width: 130px;
    text-align: right;
  }
  .studio-search {
    padding: 22px;
    max-height: 88svh;
  }
  .search-top h2 {
    font-size: 26px;
  }
  .search-field input {
    font-size: 14px;
  }
  .search-results > a {
    font-size: 14px;
  }
  .studio-search .fcl-muted {
    font-size: 12px;
  }
  .studio-page .fcl-empty {
    min-height: 400px;
    padding-block: 70px;
  }
}
@media (max-width: 355px) {
  .form-grid {
    grid-template-columns: 1fr;
  }
  .menu-solution-grid {
    grid-template-columns: 1fr;
  }
  .menu-solution-grid > a {
    min-height: 46px;
    font-size: 14px;
  }
  .studio-home .hero-copy h1,
  .studio-home .hero-copy h2 {
    font-size: 28px;
  }
  .footer-invitation {
    font-size: 60px;
  }
  .studio-home .company-stats dt {
    font-size: 31px;
  }
  .client-name-directory > span {
    font-size: 14px;
  }
  .partner-directory article {
    grid-template-columns: 85px 1fr;
    gap: 16px;
  }
}
@media (prefers-reduced-motion: reduce) {
  *,
  *:before,
  *:after {
    animation: none !important;
    transition: none !important;
    scroll-behavior: auto !important;
  }
  .fcl-photo img,
  .reference-image img {
    transform: none !important;
  }
}
@media (forced-colors: active) {
  * {
    scrollbar-color: auto;
  }
  .studio-header {
    background: Canvas;
    backdrop-filter: none;
  }
  .fcl-photo {
    forced-color-adjust: none;
  }
}
@media print {
  .studio-header,
  .global-footer,
  .fcl-contact-band,
  .studio-search,
  .scroll-progress,
  .back-top,
  .project-toolbar,
  .review-actions,
  .enquiry-form {
    display: none !important;
  }
  .studio-page {
    padding: 0;
  }
  .fcl-section {
    padding-block: 25px;
  }
  .fcl-container {
    padding-inline: 0;
  }
  .fcl-page-intro {
    padding-block: 20px;
  }
  .studio-page h1 {
    font-size: 32px;
  }
  .studio-page h2 {
    font-size: 24px;
  }
  .fcl-photo,
  .reference-image {
    break-inside: avoid;
  }
  .studio-home .hero {
    height: 450px;
    min-height: 0;
  }
  .studio-home .company-panel,
  .global-footer {
    print-color-adjust: exact;
  }
}

/* Shared header geometry: menus must fit below the actual header height. */
.studio-menu {
  max-height: calc(100svh - 102px);
}
.studio-header.is-compact .studio-menu {
  max-height: calc(100svh - 78px);
}
@media (max-width: 900px) {
  .studio-menu {
    max-height: calc(100svh - 84px);
  }
  .studio-header.is-compact .studio-menu {
    max-height: calc(100svh - 72px);
  }
}
@media (max-width: 650px) {
  .solution-detail-visual .fcl-photo {
    aspect-ratio: 2.4;
  }
}

.route-loading {
  min-height: 70svh;
  padding-block: 100px;
}
.route-loading p {
  font-family: var(--font-display);
  font-size: 24px;
  margin-top: 20px;
}
.profile-browser-toolbar > label,
.profile-browser-toolbar select {
  min-width: 0;
}
.profile-browser-toolbar select {
  width: 100%;
}
