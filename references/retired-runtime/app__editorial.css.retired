/* Monochrome company pages and progressive text motion. */
:root {
  --section: #f0f0f0;
  --paper: #f5f5f5;
}
.studio-page > main:not(.studio-home) {
  background: #f7f7f7;
}
.page-intro-band {
  background: #ededed;
}
.studio-page > main.about-editorial,
.studio-page > main.clients-page {
  background: #fff;
}
.motion-word-mask {
  display: inline-block;
  overflow: hidden;
  vertical-align: top;
  max-width: 100%;
  padding-bottom: 0.13em;
  margin-bottom: -0.13em;
}
.motion-word {
  display: inline-block;
  vertical-align: top;
  max-width: 100%;
  overflow-wrap: normal;
}
.about-hero {
  background: #0c0c0c;
  color: #fff;
  --ink: #fff;
  --muted-ink: #c6c6c6;
  --line: #404040;
}
.about-hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  gap: 80px;
  padding-block: 72px 56px;
  align-items: stretch;
}
.about-hero-copy > .fcl-label {
  font-size: 13px;
  color: #bdbdbd;
  margin-bottom: 32px;
}
.studio-page .about-hero h1 {
  font-size: clamp(64px, 6.7vw, 100px);
  line-height: 1.02;
  letter-spacing: -0.055em;
  font-weight: 700;
}
.about-hero .about-hero-lead {
  font-size: 20px;
  line-height: 1.65;
  max-width: 490px;
  margin-top: 30px;
}
.about-hero .fcl-link {
  display: inline-flex;
  color: #fff;
  font-size: 16px;
  min-height: 44px;
  margin-top: 28px;
}
.about-hero-grid > .fcl-photo {
  aspect-ratio: auto;
  min-height: 460px;
  height: 100%;
}
.about-proof {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 56px;
  padding-bottom: 56px;
}
.about-proof > div {
  border-top: 1px solid #404040;
  padding-top: 26px;
}
.about-proof dt {
  font: 700 clamp(48px, 4.6vw, 68px) / 1.1 var(--font-display);
  letter-spacing: -0.05em;
}
.about-proof dt > span {
  font-size: 0.44em;
  margin-left: 3px;
}
.about-proof dd {
  font-size: 15px;
  color: #bdbdbd;
  margin-top: 12px;
}
.about-story {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 80px;
  align-items: start;
  padding-block: 96px;
}
.about-story > .fcl-photo {
  aspect-ratio: 1.2;
}
.about-story .company-metadata {
  gap: 8px 20px;
}
.about-story .company-metadata .fcl-label {
  font-size: 12px;
  line-height: 1.6;
}
.about-story h2 {
  font-size: clamp(36px, 3.5vw, 50px);
  margin-top: 24px;
  line-height: 1.1;
}
.about-story p {
  font-size: 18px;
  line-height: 1.75;
  margin-top: 24px;
}
.about-story .fcl-link {
  display: inline-flex;
  min-height: 44px;
  margin-top: 24px;
}
.about-principles {
  padding-block: 88px;
  background: #f0f0f0;
}
.about-principles h2 {
  margin-top: 24px;
  max-width: 1040px;
  font-size: clamp(38px, 4.6vw, 66px);
  line-height: 1.1;
}
.about-principles .principles-lead {
  max-width: 800px;
  margin-top: 32px;
  font-size: 23px;
  line-height: 1.6;
}
.about-principles p:not(.fcl-label):not(.principles-lead) {
  max-width: 800px;
  font-size: 18px;
  line-height: 1.75;
  margin-top: 24px;
}
.about-markets {
  padding-block: 96px;
}
.about-markets > header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 24px;
  margin-bottom: 40px;
}
.about-markets h2 {
  font-size: clamp(36px, 3.5vw, 50px);
  line-height: 1.1;
}
.about-markets > .fcl-photo {
  aspect-ratio: 2.3;
}
.about-markets > p {
  max-width: 980px;
  font-size: 19px;
  line-height: 1.7;
  margin-top: 28px;
}
@media (max-width: 1100px) {
  .about-hero-grid,
  .about-story {
    gap: 48px;
  }
  .studio-page .about-hero h1 {
    font-size: 64px;
  }
  .about-hero-grid > .fcl-photo {
    min-height: 420px;
  }
}
@media (max-width: 900px) {
  .about-hero-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
  }
  .studio-page .about-hero h1 {
    font-size: clamp(58px, 8.5vw, 76px);
  }
  .about-hero-grid > .fcl-photo {
    aspect-ratio: 1.7;
    min-height: 0;
    height: auto;
  }
  .about-hero .about-hero-lead {
    max-width: 600px;
  }
  .about-story {
    gap: 40px;
  }
  .about-story p {
    font-size: 17px;
  }
}
@media (max-width: 650px) {
  .about-hero-grid {
    padding-block: 44px 40px;
    gap: 32px;
  }
  .about-hero-copy > .fcl-label {
    font-size: 12px;
    margin-bottom: 24px;
  }
  .studio-page .about-hero h1 {
    font-size: clamp(44px, 11.6vw, 64px);
    line-height: 1.04;
  }
  .about-hero .about-hero-lead {
    font-size: 17px;
    line-height: 1.7;
    margin-top: 24px;
  }
  .about-hero .fcl-link {
    margin-top: 20px;
    font-size: 15px;
  }
  .about-hero-grid > .fcl-photo {
    aspect-ratio: 1.35;
  }
  .about-proof {
    gap: 20px;
    padding-bottom: 40px;
  }
  .about-proof > div {
    padding-top: 20px;
  }
  .about-proof dt {
    font-size: clamp(34px, 9.6vw, 46px);
  }
  .about-proof dd {
    font-size: 13px;
    line-height: 1.55;
    margin-top: 12px;
  }
  .about-story {
    grid-template-columns: minmax(0, 1fr);
    padding-block: 64px 48px;
    gap: 36px;
  }
  .about-story > .fcl-photo {
    aspect-ratio: 1.35;
  }
  .about-story h2 {
    font-size: 36px;
    margin-top: 20px;
  }
  .about-story p {
    font-size: 17px;
    margin-top: 20px;
  }
  .about-story .fcl-link {
    margin-top: 18px;
  }
  .about-principles {
    padding-block: 56px;
  }
  .about-principles h2 {
    font-size: 36px;
    margin-top: 20px;
  }
  .about-principles .principles-lead {
    font-size: 21px;
    margin-top: 28px;
  }
  .about-principles p:not(.fcl-label):not(.principles-lead) {
    font-size: 17px;
  }
  .about-markets {
    padding-block: 64px;
  }
  .about-markets > header {
    align-items: start;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 28px;
  }
  .about-markets > .fcl-photo {
    aspect-ratio: 1.3;
  }
  .about-markets > p {
    font-size: 17px;
    margin-top: 24px;
  }
}
@media (max-width: 355px) {
  .studio-page .about-hero h1 {
    font-size: 42px;
  }
  .about-proof {
    gap: 16px;
  }
  .about-proof dd {
    font-size: 12px;
  }
}
@media (prefers-reduced-motion: reduce), print {
  .motion-word,
  .text-motion-heading {
    opacity: 1 !important;
    transform: none !important;
    filter: none !important;
  }
}
