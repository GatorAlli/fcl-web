"use client";

import { useEffect, useRef, useState } from "react";
import { filmSource, type FilmName } from "@/lib/films";

export function FilmLayer({
  name,
  active = true,
  controls = true,
  onPauseChange,
}: {
  name: FilmName;
  active?: boolean;
  controls?: boolean;
  onPauseChange?: (paused: boolean) => void;
}) {
  const video = useRef<HTMLVideoElement>(null);
  const [ready, setReady] = useState(false);
  const [playing, setPlaying] = useState(false);
  const [userPaused, setUserPaused] = useState(false);
  const [userStarted, setUserStarted] = useState(false);
  const [failed, setFailed] = useState(false);
  const [allowed, setAllowed] = useState(true);

  useEffect(() => {
    const read = () => {
      try {
        const saved = JSON.parse(
          localStorage.getItem("felix-film-selection") || "null",
        );
        const reviewed = JSON.parse(
          localStorage.getItem("felix-film-reviewed") || "null",
        );
        const known = Array.isArray(reviewed)
          ? reviewed
          : [
              "industry",
              "architecture",
              "home",
              "engineering",
              "laboratory",
              "power",
              "parking",
              "real-automation",
              "lighting-control",
              "ventilation",
            ];
        setAllowed(
          !Array.isArray(saved) ||
            saved.includes(name) ||
            !known.includes(name),
        );
      } catch {
        setAllowed(true);
      }
    };
    const frame = requestAnimationFrame(read);
    window.addEventListener("storage", read);
    return () => {
      cancelAnimationFrame(frame);
      window.removeEventListener("storage", read);
    };
  }, [name]);

  useEffect(() => {
    const media = video.current;
    if (!media || failed || !allowed) return;
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const hero = media.closest(".hero");
    const content = hero?.parentElement?.querySelector(".home-content-layer");
    let visible = false;
    let frame = 0;
    const sync = () => {
      const focus = document.activeElement;
      const focusedHero =
        hero &&
        focus &&
        hero.contains(focus) &&
        focus.matches(":focus-visible");
      const covered =
        hero &&
        content &&
        content.getBoundingClientRect().top <
          hero.getBoundingClientRect().top + 120;
      const canPlay =
        active &&
        visible &&
        !document.hidden &&
        !userPaused &&
        (!motion.matches || userStarted) &&
        (!focusedHero || userStarted) &&
        !covered;
      if (canPlay) {
        if (!media.getAttribute("src")) media.src = filmSource(name);
        void media.play().catch(() => setPlaying(false));
      } else media.pause();
    };
    const onScroll = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(sync);
    };
    const observer = new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        sync();
      },
      { threshold: 0.1 },
    );
    observer.observe(media);
    motion.addEventListener("change", sync);
    document.addEventListener("visibilitychange", sync);
    document.addEventListener("focusin", onScroll);
    document.addEventListener("focusout", onScroll);
    if (hero) window.addEventListener("scroll", onScroll, { passive: true });
    return () => {
      observer.disconnect();
      cancelAnimationFrame(frame);
      motion.removeEventListener("change", sync);
      document.removeEventListener("visibilitychange", sync);
      document.removeEventListener("focusin", onScroll);
      document.removeEventListener("focusout", onScroll);
      if (hero) window.removeEventListener("scroll", onScroll);
      media.pause();
    };
  }, [name, active, userPaused, userStarted, failed, allowed]);

  if (!allowed) return null;
  return (
    <div
      className={`film-layer ${ready && !failed ? "is-ready" : ""}`}
      data-film={name}
    >
      <video
        ref={video}
        muted
        loop
        playsInline
        preload="none"
        aria-hidden="true"
        onPlaying={() => {
          setReady(true);
          setPlaying(true);
        }}
        onPause={() => setPlaying(false)}
        onError={() => {
          setFailed(true);
          setPlaying(false);
        }}
      />
      {controls && !failed && (
        <button
          type="button"
          className="film-control"
          aria-label={playing ? "Pause video" : "Play video"}
          onClick={() => {
            setUserStarted(true);
            setUserPaused(playing);
            onPauseChange?.(playing);
          }}
        />
      )}
    </div>
  );
}
